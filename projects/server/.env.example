# Database (existing)
DB_NAME=my_database
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432

# Document Layout+OCR / Vision LLM
# paddle | paddle_llm | vision_llm | pymupdf | pymupdf_ocr | docling
DOCUMENT_DETECTION_ENGINE=paddle
DOCUMENT_OCR_LANG=korean
DOCUMENT_USE_STUB_FALLBACK=true
DOCUMENT_VISION_MAX_PAGES=5
# 비우면 DOCUMENT_LLM_MODEL 사용 (vision 권장: gpt-4o / gpt-4o-mini)
DOCUMENT_VISION_MODEL=

# OpenAI-compatible LLM (polish / vision)
DOCUMENT_LLM_ENABLED=false
DOCUMENT_LLM_BASE_URL=https://api.openai.com/v1
DOCUMENT_LLM_API_KEY=
DOCUMENT_LLM_MODEL=gpt-4o-mini
